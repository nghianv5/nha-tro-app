# Chuỗi kết nối DB (mặc định: PostgreSQL localhost, DB nhatro)
DATABASE_URL=postgresql+psycopg2://nhatro:nhatro@localhost:5432/nhatro
# Khóa ký JWT — bắt buộc đổi khi chạy thật
SECRET_KEY=doi-khoa-nay-khi-chay-that
# Thời hạn token (ngày), mặc định 7
ACCESS_TOKEN_EXPIRE_DAYS=7
# Nạp dữ liệu mẫu khi khởi động và DB còn trống (mặc định: tắt).
# Chỉ bật khi muốn có dữ liệu mẫu; tắt rồi thì khởi động lại cũng không
# nạp thêm gì, dữ liệu thật không bị động tới.
SEED_SAMPLE_DATA=false
# Thư mục lưu ảnh tải lên (trên Render: gắn Persistent Disk rồi trỏ vào đó)
UPLOAD_DIR=./uploads
